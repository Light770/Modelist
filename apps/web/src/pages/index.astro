---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
---

<BaseLayout title="Modelist — Hybrid Parametric Patternmaking CAD">
  <div class="min-h-screen flex flex-col" style="background: var(--bg-canvas); color: var(--text-primary);">
    <!-- Header -->
    <header class="border-b" style="border-color: var(--border-subtle); background: var(--bg-surface);">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center font-mono-num text-sm font-semibold text-white" style="background: var(--accent);">
            M
          </div>
          <div>
            <span class="font-semibold tracking-tight text-base">Modelist</span>
            <span class="ml-2 text-xs font-mono-num px-2 py-0.5 rounded-full border" style="border-color: var(--border-subtle); color: var(--text-secondary);">
              CAD Studio v0.1
            </span>
          </div>
        </div>
        <nav class="flex items-center gap-6 text-sm">
          <a href="#architecture" class="hover:underline" style="color: var(--text-secondary);">Architecture</a>
          <a href="#templates" class="hover:underline" style="color: var(--text-secondary);">Block Library</a>
          <a
            href="/studio?template=bodice_sleeve"
            class="px-4 py-2 rounded-lg font-medium text-white shadow-sm transition hover:opacity-95"
            style="background: var(--accent);"
          >
            Launch Studio
          </a>
        </nav>
      </div>
    </header>

    <!-- Hero -->
    <main class="flex-1">
      <section class="max-w-6xl mx-auto px-6 pt-16 pb-14 grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono-num border" style="border-color: var(--border-subtle); background: var(--bg-surface); color: var(--text-secondary);">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Rust + WebAssembly Kernel · Exact f64 mm · Local-First
          </div>
          <h1 class="text-4xl sm:text-5xl font-bold tracking-tight leading-[1.1]">
            Digital paper fluidity.<br />
            Non-breaking parametric math.
          </h1>
          <p class="text-lg leading-relaxed max-w-2xl" style="color: var(--text-secondary);">
            Draft with direct Bézier curves, seam walking, dart pivoting, and slash-and-spread—backed quietly by a topological dependency DAG, variable seam allowances with folded hems, dual RTW/MTM grading, projector PDFs, and strict DXF-AAMA R12 export.
          </p>
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="/studio?template=bodice_sleeve"
              class="px-5 py-3 rounded-xl font-medium text-white shadow-sm transition hover:opacity-95"
              style="background: var(--accent);"
            >
              Open Bodice &amp; Sleeve Studio
            </a>
            <a
              href="/studio?template=aline_skirt"
              class="px-5 py-3 rounded-xl font-medium border transition hover:opacity-90"
              style="border-color: var(--border-strong); background: var(--bg-surface);"
            >
              Open A-Line Skirt Block
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl border p-5 shadow-sm space-y-4" style="border-color: var(--border-subtle); background: var(--bg-surface);">
            <div class="flex items-center justify-between text-xs font-mono-num pb-3 border-b" style="border-color: var(--border-subtle); color: var(--text-secondary);">
              <span>KERNEL TELEMETRY</span>
              <span>CCW / 1e-6 mm</span>
            </div>
            <div class="grid grid-cols-2 gap-3 text-sm">
              <div class="p-3 rounded-xl border" style="border-color: var(--border-subtle); background: var(--bg-panel);">
                <div class="text-xs" style="color: var(--text-muted);">Curve Arc Inversion</div>
                <div class="font-mono-num font-semibold mt-1">&lt; 0.01 mm</div>
              </div>
              <div class="p-3 rounded-xl border" style="border-color: var(--border-subtle); background: var(--bg-panel);">
                <div class="text-xs" style="color: var(--text-muted);">R*-Tree Snap Index</div>
                <div class="font-mono-num font-semibold mt-1">&lt; 1 ms</div>
              </div>
              <div class="p-3 rounded-xl border" style="border-color: var(--border-subtle); background: var(--bg-panel);">
                <div class="text-xs" style="color: var(--text-muted);">Apparel Corners</div>
                <div class="font-mono-num font-semibold mt-1">FoldedHem + Miter</div>
              </div>
              <div class="p-3 rounded-xl border" style="border-color: var(--border-subtle); background: var(--bg-panel);">
                <div class="text-xs" style="color: var(--text-muted);">Industrial DXF</div>
                <div class="font-mono-num font-semibold mt-1">ASTM D6673 R12</div>
              </div>
            </div>
            <p class="text-xs leading-relaxed" style="color: var(--text-muted);">
              Your patterns stay on your machine as open <code class="font-mono-num">.modelist.json</code> archives with zero cloud lock-in or subscription tax.
            </p>
          </div>
        </div>
      </section>

      <!-- Block Library -->
      <section id="templates" class="max-w-6xl mx-auto px-6 py-10">
        <div class="flex items-baseline justify-between mb-6">
          <h2 class="text-xl font-semibold tracking-tight">Parametric Starter Blocks</h2>
          <span class="text-xs font-mono-num" style="color: var(--text-muted);">XS – XXL + Custom Measurements</span>
        </div>
        <div class="grid md:grid-cols-3 gap-5">
          <a href="/studio?template=bodice_sleeve" class="group rounded-2xl border p-6 transition hover:shadow-md" style="border-color: var(--border-subtle); background: var(--bg-surface);">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono-num px-2.5 py-1 rounded-md" style="background: var(--accent-soft); color: var(--accent);">3 PIECES · MULTI-EDGE ARMHOLE</span>
              <span class="text-xs font-mono-num" style="color: var(--text-muted);">FB · BB · SL</span>
            </div>
            <h3 class="text-lg font-semibold mt-4 group-hover:underline">Fitted Bodice &amp; Set-In Sleeve</h3>
            <p class="text-sm mt-2 leading-relaxed" style="color: var(--text-secondary);">
              Unified Front+Back Armhole interface actively drives Sleeve Cap height &amp; ease live, with auto-projected partner notches, waist darts, and flared FoldedHem sleeve allowance.
            </p>
          </a>
          <a href="/studio?template=aline_skirt" class="group rounded-2xl border p-6 transition hover:shadow-md" style="border-color: var(--border-subtle); background: var(--bg-surface);">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono-num px-2.5 py-1 rounded-md" style="background: var(--accent-soft); color: var(--accent);">2 PIECES · SYMMETRY FOLD</span>
              <span class="text-xs font-mono-num" style="color: var(--text-muted);">FS · BS</span>
            </div>
            <h3 class="text-lg font-semibold mt-4 group-hover:underline">Tailored A-Line Skirt</h3>
            <p class="text-sm mt-2 leading-relaxed" style="color: var(--text-secondary);">
              Cut-on-Fold Front &amp; CB-Zip Back with live mirror symmetry ghost, interdependent side-seam binding, hip notches, 30 mm FoldedHem corners, and parametric flare formula.
            </p>
          </a>
          <a href="/studio?template=trouser_block" class="group rounded-2xl border p-6 transition hover:shadow-md" style="border-color: var(--border-subtle); background: var(--bg-surface);">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono-num px-2.5 py-1 rounded-md" style="background: var(--accent-soft); color: var(--accent);">2 PIECES · INSEAM + OUTSEAM</span>
              <span class="text-xs font-mono-num" style="color: var(--text-muted);">FT · BT</span>
            </div>
            <h3 class="text-lg font-semibold mt-4 group-hover:underline">Tailored Trouser Block</h3>
            <p class="text-sm mt-2 leading-relaxed" style="color: var(--text-secondary);">
              Front &amp; Back Trouser slopers with curved J-fly &amp; seat rise, active outseam/inseam length bindings, knee notches, crease grainlines, and 30 mm turned hem corners.
            </p>
          </a>
        </div>
      </section>

      <!-- Starter Styles (relaxed silhouettes) -->
      <section id="starter-styles" class="max-w-6xl mx-auto px-6 pb-10">
        <div class="flex items-baseline justify-between mb-6">
          <h2 class="text-xl font-semibold tracking-tight">Starter Styles</h2>
          <span class="text-xs font-mono-num" style="color: var(--text-muted);">Relaxed silhouettes · unisex · graded XS – XXL</span>
        </div>
        <div class="grid md:grid-cols-3 gap-5">
          <a href="/studio?template=boxy_tee" class="group rounded-2xl border p-6 transition hover:shadow-md" style="border-color: var(--border-subtle); background: var(--bg-surface);">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono-num px-2.5 py-1 rounded-md" style="background: var(--accent-soft); color: var(--accent);">4 PIECES · DROP SHOULDER</span>
              <span class="text-xs font-mono-num" style="color: var(--text-muted);">TE</span>
            </div>
            <h3 class="text-lg font-semibold mt-4 group-hover:underline">Oversized Drop-Shoulder Tee</h3>
            <p class="text-sm mt-2 leading-relaxed" style="color: var(--text-secondary);">
              Boxy unisex body with dropped shoulders, a low-cap sleeve solved to the armhole and a neck rib bound at 85 %. The base for oversized tees, sweatshirts and hoodies.
            </p>
          </a>
          <a href="/studio?template=wide_pleat_trouser" class="group rounded-2xl border p-6 transition hover:shadow-md" style="border-color: var(--border-subtle); background: var(--bg-surface);">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono-num px-2.5 py-1 rounded-md" style="background: var(--accent-soft); color: var(--accent);">3 PIECES · 2 PLEATS</span>
              <span class="text-xs font-mono-num" style="color: var(--text-muted);">WL</span>
            </div>
            <h3 class="text-lg font-semibold mt-4 group-hover:underline">Pleated Wide-Leg Trouser</h3>
            <p class="text-sm mt-2 leading-relaxed" style="color: var(--text-secondary);">
              Two front pleats taken as explicit waistband ease, a wide straight leg with a 56 cm opening, and a folded waistband with underlap.
            </p>
          </a>
          <a href="/studio?template=barrel_trouser" class="group rounded-2xl border p-6 transition hover:shadow-md" style="border-color: var(--border-subtle); background: var(--bg-surface);">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono-num px-2.5 py-1 rounded-md" style="background: var(--accent-soft); color: var(--accent);">3 PIECES · CURVED LEG</span>
              <span class="text-xs font-mono-num" style="color: var(--text-muted);">BL</span>
            </div>
            <h3 class="text-lg font-semibold mt-4 group-hover:underline">Barrel-Leg Trouser</h3>
            <p class="text-sm mt-2 leading-relaxed" style="color: var(--text-secondary);">
              Full at the knee and tapered to a 40 cm hem, with one front pleat. Change the knee bulge and opening to move between straight, barrel and balloon.
            </p>
          </a>
        </div>
      </section>

      <!-- Architecture Highlights -->
      <section id="architecture" class="max-w-6xl mx-auto px-6 py-10 pb-20">
        <h2 class="text-xl font-semibold tracking-tight mb-6">Built to Solve Patternmakers' Core Frustrations</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 text-sm">
          <div class="rounded-xl border p-5" style="border-color: var(--border-subtle); background: var(--bg-surface);">
            <h3 class="font-semibold mb-1.5">Imperative 120 FPS Viewport</h3>
            <p style="color: var(--text-secondary);">Pattern contours, cutlines, handles, and graded nests render directly from Rust/WASM Float32Array buffers—never lagging React DOM/SVG nodes.</p>
          </div>
          <div class="rounded-xl border p-5" style="border-color: var(--border-subtle); background: var(--bg-surface);">
            <h3 class="font-semibold mb-1.5">Seam Walking &amp; Cross-Size QA</h3>
            <p style="color: var(--text-secondary);">Roll joined pieces along arc-length curves to inspect notches and verify sleeve-cap or side-seam ease simultaneously across XS through XXL.</p>
          </div>
          <div class="rounded-xl border p-5" style="border-color: var(--border-subtle); background: var(--bg-surface);">
            <h3 class="font-semibold mb-1.5">Zero-Illustrator-Tax Exports</h3>
            <p style="color: var(--text-secondary);">Generate optimal A4/Letter tiled PDFs with assembly map, A0 copyshop, unfolded projector PDFs, exact-mm SVGs, POM CSVs, and strict DXF-AAMA R12.</p>
          </div>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
